# Update these with your Supabase details from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-secret

# Domain configuration for production (Server-side only for better security)
APP_DOMAIN=zoro-pilot.company
ADMIN_DOMAIN=zoro-secure-control-net.company

# LiveKit Cloud (Group calls) — from your project at cloud.livekit.io
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
